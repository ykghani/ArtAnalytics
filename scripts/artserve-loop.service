[Unit]
Description=ArtServe Museum Loop Driver
After=network-online.target
Wants=network-online.target

[Service]
# --- identity ---
User=pi
WorkingDirectory=/home/pi/ArtServe/ArtServe-Downloader

# --- runtime ---
# uv run ensures the correct virtualenv is active.
ExecStart=/usr/local/bin/uv run python scripts/loop.py run

# --- environment ---
# Set your ntfy.sh topic here for push notifications.
# Environment=NTFY_TOPIC=your-private-topic
#
# Override API rate limits if needed (seconds per item):
# Environment=RATE_LIMIT_DELAY=1.0

# --- resilience ---
Restart=on-failure
RestartSec=30s
# Limit restart storms (10 restarts within 10 min → stop)
StartLimitIntervalSec=600
StartLimitBurst=10

# --- output ---
StandardOutput=journal
StandardError=journal
SyslogIdentifier=artserve-loop

[Install]
WantedBy=multi-user.target
